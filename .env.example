# LSE Data API (London Strategic Edge) — optional if using yfinance bootstrap only
LSE_API_URL=https://api.londonstrategicedge.com
LSE_API_KEY=your_lse_api_key_here
LSE_DATA_API_URL=https://data-api.londonstrategicedge.com

# Supabase — server-side (Vercel API routes + Render pipeline)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Supabase — browser (Vercel NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Next.js — set to your Vercel production host (no https://)
ALLOWED_ORIGIN=your-app.vercel.app

# Protect /api/* in production (clients send header x-api-key)
# Leave empty only for open demos / local dev
API_SECRET=generate-a-random-secret-here
