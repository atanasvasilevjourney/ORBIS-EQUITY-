# LSE Data API (London Strategic Edge) — optional if using yfinance bootstrap only
LSE_API_URL=https://api.londonstrategicedge.com
LSE_API_KEY=your_lse_api_key_here
LSE_DATA_API_URL=https://data-api.londonstrategicedge.com

# Supabase — server-side (Vercel API routes + Render pipeline)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Supabase — browser (Vercel NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Next.js — set to your Vercel production host (no https://)
ALLOWED_ORIGIN=your-app.vercel.app

# Protect /api/* in production (clients send header x-api-key)
# Leave empty only for open demos / local dev
API_SECRET=generate-a-random-secret-here

# Cash EOD ingest (Yahoo → Stooq public REST, no key)
# CASH_EOD_BARS=300
# CASH_EOD_MIN_BARS=200
# CASH_EOD_LIMIT=0
# CASH_EOD_SLEEP=0.12

# EOD alert digest (Resend) — emailed after nightly Trend Radar
# Create a free key at https://resend.com ; verify a domain for production From:
RESEND_API_KEY=re_xxxxxxxx
ALERT_EMAIL=you@example.com
ALERT_EMAIL_FROM=Orbis Equity Alerts <onboarding@resend.dev>
ALERT_MIN_RANK=60
ALERT_MIN_CONVERGENCE=4
ALERT_SKIP_WAIT_PULLBACK=false
APP_BASE_URL=https://your-domain.vercel.app
