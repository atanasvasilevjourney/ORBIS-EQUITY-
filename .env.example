# LSE Data API (London Strategic Edge)
LSE_API_URL=https://api.londonstrategicedge.com
LSE_API_KEY=your_lse_api_key_here
LSE_DATA_API_URL=https://data-api.londonstrategicedge.com

# Supabase — server-side (pipeline + API routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Supabase — client-side (browser, exposed via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Next.js — production domain for Server Actions
ALLOWED_ORIGIN=your-domain.vercel.app

# API authentication (used by middleware to protect /api/* routes)
API_SECRET=generate-a-random-secret-here

# EOD alert digest (Resend) — emailed after nightly Trend Radar
# Create a free key at https://resend.com ; verify a domain for production From:
RESEND_API_KEY=re_xxxxxxxx
ALERT_EMAIL=you@example.com
ALERT_EMAIL_FROM=KovaView Alerts <onboarding@resend.dev>
ALERT_MIN_RANK=60
ALERT_MIN_CONVERGENCE=4
ALERT_SKIP_WAIT_PULLBACK=false
APP_BASE_URL=https://your-domain.vercel.app
